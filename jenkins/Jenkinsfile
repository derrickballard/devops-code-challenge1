
pipeline {
    agent any

    stages {
        stage('Verify Environment') {
            steps {
                echo 'Starting DevOps deployment pipeline'
                sh 'whoami'
                sh 'docker --version'
                sh 'aws --version'
                sh 'git --version'
            }
        }

        stage('Build Frontend Docker Image') {
            steps {
                echo 'Building frontend Docker image'
                sh 'docker build -t devops-code-challenge1-frontend:test ./frontend'
            }
        }

        stage('Build Backend Docker Image') {
            steps {
                echo 'Building backend Docker image'
                sh 'docker build -t devops-code-challenge1-backend:test ./backend'
            }
        }

        stage('Login to Amazon ECR') {
            steps {
                echo 'Authenticating Docker with Amazon ECR'
                sh 'aws ecr get-login-password --region us-east-2 | docker login --username AWS --password-stdin 482681396167.dkr.ecr.us-east-2.amazonaws.com'
            }
        }

        stage('Tag Docker Images for ECR') {
            steps {
                echo 'Tagging frontend Docker image'
                sh 'docker tag devops-code-challenge1-frontend:test 482681396167.dkr.ecr.us-east-2.amazonaws.com/devops-code-challenge1-frontend:latest'

                echo 'Tagging backend Docker image'
                sh 'docker tag devops-code-challenge1-backend:test 482681396167.dkr.ecr.us-east-2.amazonaws.com/devops-code-challenge1-backend:latest'
            }
        }
        stage('Push Docker Images to ECR') {
            steps {
                echo 'Pushing frontend Docker image to Amazon ECR'
                sh 'docker push 482681396167.dkr.ecr.us-east-2.amazonaws.com/devops-code-challenge1-frontend:latest'

                echo 'Pushing backend Docker image to Amazon ECR'
                sh 'docker push 482681396167.dkr.ecr.us-east-2.amazonaws.com/devops-code-challenge1-backend:latest'
            }
        }
        stage('Verify ECS Services') {
            steps {
                echo 'Verifying frontend and backend ECS services'

                sh '''
                    aws ecs describe-services \
                        --cluster devops-code-challenge1-cluster \
                        --services devops-code-challenge1-frontend-service devops-code-challenge1-backend-service \
                        --region us-east-2 \
                        --query 'services[].{Service:serviceName,Status:status,Running:runningCount,Desired:desiredCount}' \
                        --output table
                   '''
    }
}

stage('Deploy to ECS Fargate') {
    steps {
        echo 'Deploying new Docker images to ECS Fargate'

        sh '''
            set -e

            python3 - <<'PY'
import json
import subprocess

region = "us-east-2"
cluster = "devops-code-challenge1-cluster"
account = "482681396167"
build = "${BUILD_NUMBER}"

for component in ["frontend", "backend"]:
    family = f"devops-code-challenge1-{component}"
    service = f"{family}-service"
    image = (
        f"{account}.dkr.ecr.{region}.amazonaws.com/"
        f"{family}:latest"
    )

    def aws(*args):
        return subprocess.check_output(
            ["aws", *args, "--region", region],
            text=True
        )

    current = json.loads(aws(
        "ecs", "describe-task-definition",
        "--task-definition", family,
        "--query", "taskDefinition"
    ))

    allowed = [
        "family", "taskRoleArn", "executionRoleArn",
        "networkMode", "containerDefinitions",
        "volumes", "placementConstraints",
        "requiresCompatibilities", "cpu", "memory",
        "runtimePlatform", "ephemeralStorage",
        "proxyConfiguration", "ipcMode", "pidMode"
    ]

    updated = {
        key: current[key]
        for key in allowed
        if key in current
    }

    for container in updated["containerDefinitions"]:
        if container["name"] == component:
            container["image"] = image

    with open(f"/tmp/{component}-task.json", "w") as file:
        json.dump(updated, file)

    revision = json.loads(aws(
        "ecs", "register-task-definition",
        "--cli-input-json",
        f"file:///tmp/{component}-task.json"
    ))["taskDefinition"]["taskDefinitionArn"]

    print(f"Deploying {component}: {revision}", flush=True)

    aws(
        "ecs", "update-service",
        "--cluster", cluster,
        "--service", service,
        "--task-definition", revision
    )

aws(
    "ecs", "wait", "services-stable",
    "--cluster", cluster,
    "--services",
    "devops-code-challenge1-frontend-service",
    "devops-code-challenge1-backend-service"
)

print("Both ECS services are stable.", flush=True)
PY
        '''
    }
}
        }
    }
}
